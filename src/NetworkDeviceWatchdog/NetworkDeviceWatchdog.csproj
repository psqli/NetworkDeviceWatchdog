<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetworkDeviceWatchdog</AssemblyName>
    <RootNamespace>NetworkDeviceWatchdog.App</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NetworkDeviceWatchdog.Core/NetworkDeviceWatchdog.Core.csproj" />
    <EmbeddedResource Include="../../samples/watchdog.json" LogicalName="watchdog.sample.json" />
  </ItemGroup>

</Project>
